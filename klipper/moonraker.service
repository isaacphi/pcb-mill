[Unit]
Description=Moonraker API Server (Snapmaker Original CNC)
After=network-online.target klipper.service
Wants=klipper.service

[Install]
WantedBy=multi-user.target

[Service]
Type=simple
User=site3
SupplementaryGroups=dialout
WorkingDirectory=/home/site3/moonraker
EnvironmentFile=/home/site3/printer_data/systemd/moonraker.env
ExecStart=/home/site3/moonraker-env/bin/python $MOONRAKER_ARGS
Restart=always
RestartSec=10
